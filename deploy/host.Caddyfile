# Caddy installed on the host (apt install caddy), the only process listening on 80/443.
# Copy to /etc/caddy/Caddyfile (or `import` it from there) and replace the domains;
# apply with: systemctl reload caddy. Caddy gets Let's Encrypt certificates by itself.

# The messenger: everything goes to the app's caddy container (HTTP_PORT in .env, default 8080).
# WebSocket upgrades (/api/ws) pass through as they are.
msg.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

# Any other files: put a file into /srv/files and it is served at https://files.example.com/<name>.
# Add basic_auth here (hash: `caddy hash-password`) for anything private.
files.example.com {
	root * /srv/files
	file_server
}

# Alternative: the same folder on a path of the messenger's domain. Put the block inside the
# msg.example.com site, BEFORE the reverse_proxy line:
#
#	handle_path /files/* {
#		root * /srv/files
#		file_server
#	}
