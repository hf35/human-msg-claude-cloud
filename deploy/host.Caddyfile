# Caddy installed on the host (apt install caddy), the only process listening on 80/443.
# Copy to /etc/caddy/Caddyfile (or `import` it from there) and replace the domains;
# apply with: systemctl reload caddy. Caddy gets Let's Encrypt certificates by itself.
# Both domains need an A record pointing to this server.

# The messenger lives on a subdomain. Use this address as PUBLIC_URL in .env and as the
# authorized JavaScript origin in Google OAuth.
# WebSocket upgrades (/api/ws) pass through as they are.
msg.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

# The main domain is a plain file server: /srv/files/photo.png -> https://example.com/photo.png
# (subfolders work too, and a folder with index.html opens as a page).
# Add basic_auth here (hash: `caddy hash-password`) for anything private, and `browse` after
# file_server to show folder listings.
example.com {
	encode zstd gzip
	root * /srv/files
	file_server
}

# Optional: send www.example.com to the main domain
# www.example.com {
# 	redir https://example.com{uri} permanent
# }
