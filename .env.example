# Copy to .env and adjust. The defaults below match docker-compose.yml.
POSTGRES_USER=humanmsg
POSTGRES_PASSWORD=humanmsg
POSTGRES_DB=humanmsg
POSTGRES_PORT=5432

DATABASE_URL=postgres://humanmsg:humanmsg@localhost:5432/humanmsg

# Server (apps/server). HOST=127.0.0.1 keeps the dev server off the network; containers use 0.0.0.0
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Names this server's WebSocket connections in the database; keep it stable across restarts
SERVER_ID=server-1
# Seconds between passes of the worker and of the outbox dispatcher
WORKER_INTERVAL=5
DISPATCH_INTERVAL=5

# Web sign-in. GOOGLE_CLIENT_ID is the OAuth client id of the web app (empty: Google sign-in is off).
# DEV_LOGIN=true adds a sign-in without Google; it works only with NODE_ENV=development
GOOGLE_CLIENT_ID=
DEV_LOGIN=true
# Seconds between WebSocket pings; a connection that misses one pong is closed
WS_PING_INTERVAL=30

# Web app (apps/web, Vite): the same OAuth client id as GOOGLE_CLIENT_ID; empty hides the Google button
VITE_GOOGLE_CLIENT_ID=
