# Internal app proxy (docker-compose.prod.yml): plain HTTP on :80, published on 127.0.0.1 only.
# HTTPS and the public domain are handled by the Caddy installed on the host (deploy/host.Caddyfile),
# which proxies to this container; docs/DEPLOY.md describes the setup.
{
	auto_https off
	servers {
		# Trust the host Caddy (it reaches us from a private docker address) so that the real client
		# address from X-Forwarded-For is passed on to the server instead of being overwritten
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Everything dynamic goes to the server. WebSocket upgrades (/api/ws) pass through as they are.
	# The back office API (/admin/api/*) must be matched before the back office pages (/admin*)
	@server path /api/* /admin/api/* /telegram/webhook
	handle @server {
		reverse_proxy server:3000
	}

	# Back office SPA (built with base /admin/); unknown paths fall back to its index.html
	handle /admin* {
		root * /srv
		try_files {path} /admin/index.html
		file_server
	}

	# Web app SPA
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	# Hashed bundles never change; index.html must always be revalidated
	@assets path /assets/* /admin/assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html /admin /admin/ /admin/index.html
	header @html Cache-Control "no-cache"
}
